{
  "name": "@zethictech/obsidian-mcp",
  "version": "1.0.3",
  "description": "MCP server for Obsidian, wrapping the official CLI (1.12+)",
  "author": {
    "name": "ZethicTech",
    "url": "https://github.com/ZethicTech"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
