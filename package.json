{
  "name": "@zethictech/obsidian-mcp",
  "version": "1.1.7",
  "description": "Access your Obsidian vault from Claude Desktop and other AI tools — MCP server wrapping the official Obsidian CLI with tools, resources, and prompts",
  "author": {
    "name": "ZethicTech",
    "url": "https://github.com/ZethicTech"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "obsidian-mcp": "dist/bin/obsidian-mcp.js"
  },
  "main": "./dist/src/index.js",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ZethicTech/obsidian-mcp.git"
  },
  "homepage": "https://github.com/ZethicTech/obsidian-mcp#readme",
  "bugs": {
    "url": "https://github.com/ZethicTech/obsidian-mcp/issues"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx bin/obsidian-mcp.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "test": "vitest run",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "lint-staged": {
    "*.ts": [
      "eslint",
      "prettier --check"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --check"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "obsidian",
    "obsidian-vault",
    "obsidian-notes",
    "obsidian-plugin",
    "mcp",
    "mcp-server",
    "mcp-tools",
    "mcp-resources",
    "model-context-protocol",
    "claude",
    "claude-desktop",
    "claude-code",
    "anthropic",
    "ai",
    "ai-tools",
    "llm",
    "note-taking",
    "knowledge-management"
  ],
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^20.0.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.11"
  }
}
